<UserControl x:Class="MultiAiWorkspace.Controls.AiPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid Background="#FFF7F8FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="#FF20242B" Padding="10,7">
      <DockPanel>
        <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="15" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="#FF9DE2B0" HorizontalAlignment="Right" Text="起動中…" />
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#FFE9ECF1" Padding="7">
      <StackPanel Orientation="Horizontal">
        <Button Content="貼付" Click="Paste_Click" Padding="14,5" Margin="0,0,6,0" ToolTip="共通入力をこのWebページの入力欄へ入れます（送信はしません）" />
        <Button Content="送信" Click="Send_Click" Padding="14,5" Margin="0,0,6,0" ToolTip="このWebページで現在入力されている文章を送信します" />
        <Button Content="コピー" Click="Copy_Click" Padding="14,5" ToolTip="最新のAI回答をクリップボードへコピーします" />
      </StackPanel>
    </Border>
    <wv2:WebView2 x:Name="Browser" Grid.Row="2" NavigationCompleted="Browser_NavigationCompleted" />
  </Grid>
</UserControl>

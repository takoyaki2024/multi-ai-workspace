<Window x:Class="MultiAiWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MultiAiWorkspace.Controls"
        Title="Multi AI Workspace" Width="1500" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Background="#FFF1F3F6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="#FF15181D" Padding="14,9">
      <DockPanel>
        <TextBlock Text="Multi AI Workspace" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="均等に戻す" Click="Equalize_Click" Padding="15,6" Margin="0,0,8,0" />
          <Button x:Name="FullscreenButton" Content="全画面 (F11)" Click="Fullscreen_Click" Padding="15,6" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Padding="12" Background="White" BorderBrush="#FFD3D7DE" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="CommonInput" MinHeight="70" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="9" FontSize="14"
                 ToolTip="3つのAIへ渡す文章を入力してください。貼付だけでは送信されません。" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
          <Button Content="全部へ貼付" Click="PasteAll_Click" Padding="18,7" Margin="0,0,0,7" />
          <Button Content="全部へ送信" Click="SendAll_Click" Padding="18,7" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="PaneGrid" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="240" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="CenterColumn" Width="*" MinWidth="240" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="240" />
      </Grid.ColumnDefinitions>
      <controls:AiPaneControl x:Name="ChatGptPane" Grid.Column="0" />
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#FFB6BBC4" ShowsPreview="True" />
      <controls:AiPaneControl x:Name="GeminiPane" Grid.Column="2" />
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#FFB6BBC4" ShowsPreview="True" />
      <controls:AiPaneControl x:Name="ClaudePane" Grid.Column="4" />
    </Grid>
  </Grid>
</Window>
